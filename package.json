{
  "name": "lakkanna-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "export": "next build",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sandcastle": "npx tsx .sandcastle/main.mts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.0",
    "lucide-react": "^1.16.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.10",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dom-chromium-ai": "^0.0.16",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.7",
    "@tailwindcss/postcss": "^4.3.0",
    "postcss": "^8.4.39",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "msgpackr-extract",
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
